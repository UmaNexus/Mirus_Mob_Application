{
  "expo": {
    "name": "MIRUS Field Force",
    "slug": "mirus-field-force",
    "scheme": "mirus",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "plugins": ["expo-notifications"],
    "splash": {
      "image": "./assets/logo-mirus-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.umanexus.fieldforce"
    },
    "icon": "./assets/logo-mirus-mark.png",
    "android": {
      "package": "com.umanexus.fieldforce",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-mirus-mark.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:5000/api"
    }
  }
}
