{
  "expo": {
    "name": "MIRUS Field Force",
    "slug": "mirus-field-force",
    "scheme": "mirus",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "plugins": ["expo-notifications"],
    "splash": {
      "image": "./assets/logo-mirus-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.umanexus.fieldforce"
    },
    "icon": "./assets/logo-mirus-mark.png",
    "android": {
      "package": "com.umanexus.fieldforce",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-mirus-mark.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "https://hrms-mirus.com/api",
      "webAppUrl": "https://hrms-mirus.com",
      "privacyPolicyUrl": "https://hrms-mirus.com/privacy-policy",
      "accountDeletionUrl": "https://hrms-mirus.com/account-deletion",
      "eas": {
        "projectId": "5a4df981-eace-46be-9f64-787db1bacd7a"
      }
    }
  }
}
